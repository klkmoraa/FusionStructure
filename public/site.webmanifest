{
  "name": "FusionStructure · Análisis estructural",
  "short_name": "FusionStructure",
  "description": "Plano, el solver 2D de FusionStructure: modelado, análisis y aprendizaje de estructuras planas.",
  "lang": "es",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f6f1",
  "theme_color": "#171a1c",
  "icons": [
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-structureco": [
          ".structureco"
        ],
        "application/json": [
          ".structureco.json"
        ]
      }
    }
  ]
}
