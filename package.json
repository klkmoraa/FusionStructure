{
  "name": "@fusionstructure/landing",
  "private": true,
  "version": "0.1.0",
  "description": "Landing pública del ecosistema FusionStructure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run check:local-foundation && npm run test && npm run build",
    "check:local-foundation": "node ./scripts/check-local-foundation.mjs",
    "test": "vitest run --maxWorkers=1 --pool=threads --no-file-parallelism"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
